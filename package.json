{
  "name": "boot-camp-commander",
  "version": "1.6.0",
  "private": true,
  "description": "Idle clicker game: run a Navy-style recruit training base.",
  "scripts": {
    "build": "node tools/build.js",
    "sim": "node tools/sim.js 3 1",
    "test": "node tools/plan-test.js",
    "sync": "node tools/build.js && npx cap sync",
    "deploy": "node tools/deploy.js",
    "sql": "node tools/sql.js",
    "android:apk": "node tools/build.js && npx cap sync android && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "6.2.1",
    "@capacitor/core": "6.2.1",
    "@capacitor/haptics": "6.0.3",
    "@capacitor/ios": "6.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.1"
  }
}
